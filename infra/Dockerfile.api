FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    API_HOST=0.0.0.0 \
    API_PORT=8000 \
    DATA_MODE=live

WORKDIR /app

COPY services/api /app/services/api
COPY data /app/data
COPY contracts /app/contracts

RUN pip install --no-cache-dir /app/services/api

EXPOSE 8000

CMD ["sh", "-c", "uvicorn app.main:app --app-dir /app/services/api --host ${API_HOST} --port ${API_PORT}"]
