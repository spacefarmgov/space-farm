# ==============================================================================
# Space Farm (Team CODE44) — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# SECURITY: Never commit `.env` or real API keys/tokens to Git.
# ==============================================================================

# --- Backend Service (services/api) ---
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Data retrieval mode:
# - live: query upstream NASA POWER API and cache verified responses
# - cached: serve only from verified local real snapshots/manifests
# - demo_fixture: explicit synthetic contract fixture mode (development/tests only;
#   must NEVER be enabled silently in production)
DATA_MODE=live

# --- NASA POWER Daily Point API (MVP Primary Climate Source) ---
# Note: NASA POWER Daily API does not require an API key.
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_COMMUNITY=AG
NASA_POWER_TIME_STANDARD=UTC
NASA_POWER_TIMEOUT_SECONDS=10
NASA_POWER_MAX_RETRIES=2
DATA_CACHE_DIR=./data/cache

# --- Optional Future / Extended NASA Credentials (V1/V2 Only) ---
# Leave empty unless working on future modules that explicitly require them.
NASA_API_KEY=
EARTHDATA_TOKEN=

# --- Frontend Web App (apps/web) ---
VITE_APP_NAME=Space Farm
VITE_API_BASE_URL=http://localhost:8000
