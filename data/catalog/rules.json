{
  "rules_version": "agronomy-rules-0.1.0",
  "rules": [
    {
      "rule_id": "RULE_WATER_SUPPLY_MATCH",
      "rule_type": "hard_constraint",
      "crop_ids": ["wheat", "barley", "chickpea", "lentil", "sunflower", "maize"],
      "families": ["Poaceae", "Fabaceae", "Asteraceae"],
      "condition": "effective_water_supply_mm >= crop.water_band_mm.min_mm (and <= max_mm * 1.4 waterlogging guard)",
      "severity": "hard",
      "threshold": "per-crop water_band_mm",
      "unit": "mm/season",
      "region": "Pilot generalized (Ganja/semi-arid baseline)",
      "applicability": "Applies to rainfed and irrigated schedules; if irrigation_type is unknown, marked unknown/provisional.",
      "source_url": "https://www.fao.org/4/x0490e/x0490e00.htm",
      "checked_at": "2026-11-14",
      "validation_status": "source_supported"
    },
    {
      "rule_id": "RULE_SOIL_PH_RANGE",
      "rule_type": "hard_constraint",
      "crop_ids": ["wheat", "barley", "chickpea", "lentil", "sunflower", "maize"],
      "families": ["Poaceae", "Fabaceae", "Asteraceae"],
      "condition": "soil.ph within [crop.soil_ph_range.min_ph, crop.soil_ph_range.max_ph]; unknown pH stays unknown",
      "severity": "hard",
      "threshold": "per-crop soil_ph_range",
      "unit": "pH",
      "region": "Generalized FAO soil tolerance",
      "applicability": "When soil.ph is null, result is 'unknown' and plan status becomes 'provisional' with high uncertainty.",
      "source_url": "https://www.fao.org/land-water/databases-and-software/cropwat/en/",
      "checked_at": "2026-11-14",
      "validation_status": "source_supported"
    },
    {
      "rule_id": "RULE_NO_CONSECUTIVE_SAME_CROP",
      "rule_type": "hard_constraint",
      "crop_ids": ["wheat", "barley", "chickpea", "lentil", "sunflower", "maize"],
      "families": ["Poaceae", "Fabaceae", "Asteraceae"],
      "condition": "year[t].crop_id != year[t-1].crop_id (including latest entry in farm.crop_history before Year 1)",
      "severity": "hard",
      "threshold": "0 consecutive repeats",
      "unit": "years",
      "region": "General rotational agronomy",
      "applicability": "Prevents continuous monoculture pest and residue buildup across adjacent seasons.",
      "source_url": "https://www.fao.org/4/x0490e/x0490e00.htm",
      "checked_at": "2026-11-14",
      "validation_status": "source_supported"
    },
    {
      "rule_id": "RULE_NO_CONSECUTIVE_SENSITIVE_FAMILY",
      "rule_type": "hard_constraint",
      "crop_ids": ["chickpea", "lentil", "sunflower"],
      "families": ["Fabaceae", "Asteraceae"],
      "condition": "For sensitive disease-prone families (Fabaceae, Asteraceae), year[t].family != year[t-1].family",
      "severity": "hard",
      "threshold": "1+ break years between sensitive-family crops",
      "unit": "years",
      "region": "Semi-arid pulse/oilseed rotations",
      "applicability": "Reduces Ascochyta/Fusarium/Sclerotinia carryover risk in pulse and sunflower sequences.",
      "source_url": "https://www.fao.org/land-water/databases-and-software/cropwat/en/",
      "checked_at": "2026-11-14",
      "validation_status": "provisional"
    },
    {
      "rule_id": "RULE_SOFT_WATER_FIT",
      "rule_type": "soft_scoring",
      "crop_ids": ["wheat", "barley", "chickpea", "lentil", "sunflower", "maize"],
      "families": ["Poaceae", "Fabaceae", "Asteraceae"],
      "condition": "Scores alignment between effective water supply and crop optimal water band plus crop water-use efficiency.",
      "severity": "info",
      "threshold": "[0, 1]",
      "unit": "normalized_score",
      "region": "Pilot generalized",
      "applicability": "Weighted by weights_effective.water",
      "source_url": "https://www.fao.org/4/x0490e/x0490e00.htm",
      "checked_at": "2026-11-14",
      "validation_status": "provisional"
    },
    {
      "rule_id": "RULE_SOFT_SOIL_DIVERSITY_AND_NITROGEN",
      "rule_type": "soft_scoring",
      "crop_ids": ["wheat", "barley", "chickpea", "lentil", "sunflower", "maize"],
      "families": ["Poaceae", "Fabaceae", "Asteraceae"],
      "condition": "Rewards nitrogen-fixing legumes preceding heavy-feeding cereals, botanical family diversity across 3 years, and optimal pH fit.",
      "severity": "info",
      "threshold": "[0, 1]",
      "unit": "normalized_score",
      "region": "Pilot generalized",
      "applicability": "Weighted by weights_effective.soil; applies uncertainty penalty when soil.ph is unknown.",
      "source_url": "https://www.fao.org/4/x0490e/x0490e00.htm",
      "checked_at": "2026-11-14",
      "validation_status": "provisional"
    },
    {
      "rule_id": "RULE_INCOME_UNAVAILABLE_MVP",
      "rule_type": "provisional_notice",
      "crop_ids": ["wheat", "barley", "chickpea", "lentil", "sunflower", "maize"],
      "families": ["Poaceae", "Fabaceae", "Asteraceae"],
      "condition": "No verified regional price/cost dataset in MVP; income objective returns null and weights are renormalized.",
      "severity": "warning",
      "threshold": "null",
      "unit": "unavailable",
      "region": "Azerbaijan / Pilot",
      "applicability": "Prevents fabricated AZN or % profit promises.",
      "source_url": "https://www.fao.org/land-water/databases-and-software/cropwat/en/",
      "checked_at": "2026-11-14",
      "validation_status": "provisional"
    }
  ]
}
